#!/bin/sh
# Blocks commits that touch private paths or contain the plaintext canary.
set -e
CANARY="PLAINTEXT-CANARY-""LF-7f3a91"
fail=0
staged=$(git diff --cached --name-only --diff-filter=ACMR)
for f in $staged; do
  case "$f" in
    data/private/*|*.seed.json|*.plain.json|.env*.local|*/.env*.local|BUILD_PROMPT.md|*/BUILD_PROMPT.md)
      echo "pre-commit: refusing to commit private path: $f" >&2; fail=1 ;;
  esac
done
if git diff --cached -U0 --no-color | grep -F -q "$CANARY"; then
  echo "pre-commit: staged changes contain the plaintext canary. Plaintext data must never be committed." >&2
  fail=1
fi
if git diff --cached -U0 --no-color | grep -E -q '"_canary"[[:space:]]*:'; then
  echo "pre-commit: staged changes contain a \"_canary\" key (plaintext finance JSON?)" >&2
  fail=1
fi
if echo "$staged" | grep -q '^public/data.enc.json$'; then
  if ! node -e 'const e=JSON.parse(require("fs").readFileSync("public/data.enc.json","utf8"));if(Object.keys(e).sort().join()!=="ct,iter,iv,kdf,salt,v")process.exit(1)'; then
    echo "pre-commit: public/data.enc.json is not an encryption envelope" >&2; fail=1
  fi
fi
exit $fail

{
  "name": "lupo-finance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/guard-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "verify": "tsx scripts/verify.mjs",
    "encrypt": "tsx scripts/encrypt.mjs",
    "decrypt": "tsx scripts/decrypt.mjs",
    "snapshot": "tsx scripts/snapshot.mjs",
    "guard": "node scripts/guard-dist.mjs && node scripts/guard-repo.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
